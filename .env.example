# ============================================================
# HireAI GenAI — Environment Config
# LLM backend: Ollama (local). No API keys required.
# ============================================================

# --- Ollama (local inference — no API key) ---
# Install: https://ollama.com/download
# Pull model: ollama pull gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Model selection (Ollama model tags) ---
# Change to gemma3:12b or gemma3:27b for higher accuracy (needs more RAM)
PARSER_MODEL=gemma3:4b
COPILOT_MODEL=gemma3:4b
EXPLAIN_MODEL=gemma3:4b

# --- G1 Resume Parser — OCR config ---
# Path to Tesseract OCR executable, required for JPG/PNG resume parsing.
# Windows default shown below. On Linux/Mac, install via package manager
# and set to e.g. /usr/bin/tesseract or /opt/homebrew/bin/tesseract
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe


# --- Gemini fallback (team docs 8.3) ---
# If the primary Ollama model fails after 3 retries, llm_call() retries
# the same call against Gemini Flash (Google's OpenAI-compatible API).
# Leave GEMINI_API_KEY empty to skip straight to the local fallback.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# --- Local last-resort fallback ---
# Used when Gemini is unconfigured or also fails, so offline dev works.
# Set FALLBACK_ENABLED=false to disable all fallbacks.
FALLBACK_MODEL=mistral:latest
FALLBACK_ENABLED=true

# --- Infra ---
REDIS_URL=redis://localhost:6379/0
WEB_BACKEND_URL=http://localhost:8000/api

# --- Service ---
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8001
LOG_LEVEL=INFO

# --- Cost guardrails (local models cost $0, caps kept for structure) ---
DAILY_SPEND_CAP_USD=10.0
PROJECT_SPEND_CAP_USD=200.0
COST_LOG_PATH=data/cost_log.jsonl

# --- Cache ---
DEFAULT_CACHE_TTL_SECONDS=3600

# --- Slack (nightly cost summary + regression alerts) ---
# Leave empty for offline dev — scripts/nightly.py no-ops and logs instead.
SLACK_WEBHOOK_URL=
